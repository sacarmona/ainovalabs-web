---
/*
  Sección de clientes. Para sumar uno: agregar un objeto en
  `clients.items` de src/content/i18n/es.json y dejar su logo en
  public/images/clients/.
  - Logos transparentes con texto claro (lo habitual): se centran con
    margen dentro de la tarjeta oscura.
  - Logos que ya traen su propio fondo (JPG): usar "fill": true para
    que ocupen toda la tarjeta.
*/
import t from '../content/i18n/es.json';
---

<section id="clientes" class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold md:text-5xl">{t.clients.title}</h2>
      <p class="mt-4 text-lg text-ink-300">{t.clients.subtitle}</p>
    </div>

    <!-- Filas de hasta 3, siempre centradas: el 2.º cliente queda al medio de la
         primera fila (hoy Enel Green Power) y los restantes se centran debajo. -->
    <ul class="mx-auto mt-12 flex max-w-4xl flex-wrap justify-center gap-5">
      {t.clients.items.map((c) => (
        <li class="reveal w-full sm:w-[calc(50%-0.625rem)] lg:w-[calc(33.333%-0.84rem)]">
          <a
            href={c.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${c.name} (abre en una pestaña nueva)`}
            class="group flex h-36 items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-[#202c42] transition hover:border-accent-500/60"
          >
            <img
              src={c.logo}
              alt={c.name}
              loading="lazy"
              class={
                'transition duration-500 group-hover:scale-105 ' +
                (c.fill
                  ? (c.size === 'sm' ? 'h-[72%] w-auto max-w-full object-contain' : 'h-full w-auto max-w-full object-contain')
                  : (c.size === 'lg' ? 'max-h-24 max-w-[88%] object-contain' : 'max-h-16 max-w-[70%] object-contain'))
              }
            />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
