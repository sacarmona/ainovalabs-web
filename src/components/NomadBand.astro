---
// Bloque destacado en el inicio: partnership NOMAD Power (texto en es.json → nomad.teaser)
import t from '../content/i18n/es.json';
const n = t.nomad;
---

<section class="py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="reveal relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-[#03141c] via-navy-900 to-navy-950 p-8 md:p-14">
      <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-teal/15 blur-[90px]" aria-hidden="true"></div>
      <div class="relative z-10 grid items-center gap-10 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <img src="/images/nomad/logo-color-dark.svg" alt="NOMAD Power" width="432" height="77" class="mb-6 h-7 w-auto md:h-8" />
          <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">{n.teaser.kicker}</p>
          <h2 class="mt-3 font-display text-3xl font-bold md:text-4xl">{n.teaser.title}</h2>
          <p class="mt-4 max-w-xl leading-relaxed text-ink-300">{n.teaser.text}</p>
          <a
            href="/nomad"
            class="mt-7 inline-block rounded-full bg-accent-500 px-7 py-3 font-semibold text-white shadow-lg shadow-accent-500/30 transition hover:bg-accent-400"
          >
            {n.teaser.cta}
          </a>
        </div>
        <ul class="grid grid-cols-2 gap-4">
          {n.headline.map((h) => (
            <li class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-center">
              <p class="font-display text-xl font-bold text-gradient md:text-2xl">{h.value}</p>
              <p class="mt-1 text-xs leading-snug text-ink-400">{h.label}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
